#!/usr/bin/env python3
"""End nonmember sessions, retaining all administrative account locks."""
import json
import os
import subprocess
import sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'pypkg'))
import vaultwarden_revoke as revoke
import vaultwarden_config as policy
import vaultwarden_sso as sso

if subprocess.run(['systemctl', '--user', '-q', 'is-active', 'vaultwarden.service']).returncode != 0:
    sys.exit(0)
report = None
try:
    with open('settings.json') as f:
        config = json.load(f)
    state = sso.task(config, 'get-client-access', {'domain': config['domain']})
    mismatch = False
    try:
        policy.require_policy(config, state)
    except ValueError:
        mismatch = True
    members = set() if mismatch else revoke.group_member_mails(revoke.domain_settings(config['domain']), config['required_group'])
    api = revoke.AdminAPI('http://127.0.0.1:' + os.environ['TCP_PORT'], revoke.read_admin_token())
    report = revoke.reconcile(api, members)
    if mismatch:
        raise revoke.RevokeError('IdP access policy is missing, disabled or different; all sessions were ended')
    revoke.write_status(report=report)
except Exception as error:
    # Keep exception text out of status and journal: upstream errors may
    # contain URLs, LDAP credentials or task payloads.
    message = str(error) if isinstance(error, revoke.RevokeError) else type(error).__name__
    result = revoke.write_status(error=message, report=report)
    print('Vaultwarden access revocation failed: ' + message, file=sys.stderr)
    sys.exit(1)
print('Vaultwarden access revocation: ' + json.dumps(report), file=sys.stderr)
