#!/usr/bin/env python3
import os
import subprocess
from pathlib import Path

# The backup includes the accounts disabled by the revocation timer: the
# file must exist
if not os.path.exists('revoked-users.json'):
    fd = os.open('revoked-users.json', os.O_WRONLY|os.O_CREAT|os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write('{}')

active = subprocess.run(['systemctl','--user','is-active','--quiet','vaultwarden.service']).returncode == 0
try:
    if active: subprocess.run(['systemctl','--user','stop','vaultwarden.service'],check=True)
    fd = os.open('vaultwarden-data.tar.tmp', os.O_WRONLY|os.O_CREAT|os.O_TRUNC, 0o600)
    with os.fdopen(fd,'wb') as stream:
        subprocess.run(['podman','volume','export','vaultwarden-data'],stdout=stream,check=True)
    os.replace('vaultwarden-data.tar.tmp','vaultwarden-data.tar')
finally:
    if active: subprocess.run(['systemctl','--user','start','vaultwarden.service'],check=True)
