#!/usr/bin/env python3
"""Read-only systemd/start gate. Never print secrets or exception text."""
import sys
import vaultwarden_config as policy

try:
    # configure-module waits for systemd while holding configuration: do not
    # acquire that lock here. Atomic record/projection reads fail closed during
    # an incomplete transaction instead of deadlocking service startup.
    policy.check_worker_credential()
except Exception:
    print('Worker credentials are incoherent or unavailable; startup refused', file=sys.stderr)
    sys.exit(1)
