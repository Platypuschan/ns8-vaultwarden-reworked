{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "url",
    "token"
  ],
  "additionalProperties": false,
  "properties": {
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "token": {
      "type": "string",
      "minLength": 43
    },
    "frame_ancestors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    }
  }
}
