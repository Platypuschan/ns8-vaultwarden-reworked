{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "url",
    "ticket",
    "session_seconds"
  ],
  "additionalProperties": false,
  "properties": {
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "frame_ancestors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "revocation": {
      "type": "object"
    },
    "ticket": {
      "type": "string",
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "session_seconds": {
      "type": "integer",
      "minimum": 10
    }
  }
}
