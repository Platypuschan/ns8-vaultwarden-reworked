#!/usr/bin/env python3
"""Owner-only action: no get-/read- prefix (those are granted to readers)."""
import json
import subprocess
import sys

import vaultwarden_config as policy
import vaultwarden_revoke as revoke

with open('settings.json') as stream:
    config = policy.validate(json.load(stream))
if subprocess.run(['systemctl', '--user', 'is-active', '--quiet', 'vaultwarden.service']).returncode:
    raise ValueError('Vaultwarden ist noch nicht gestartet. Bitte zuerst konfigurieren.')
# The UI embeds the admin page only for cluster manager origins Vaultwarden allows.
ancestors = (policy.env_value('ALLOWED_IFRAME_ANCESTORS') or '').split()
json.dump({'url': 'https://' + config['host'] + '/admin/',
    'frame_ancestors': ancestors, 'revocation': revoke.status()}, sys.stdout)
