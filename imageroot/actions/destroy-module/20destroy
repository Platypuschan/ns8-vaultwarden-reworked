#!/usr/bin/env python3
import os
import agent
import agent.tasks
traefik = agent.resolve_agent_id('traefik@node')
if traefik:
    for instance in (os.environ['MODULE_ID'], os.environ['MODULE_ID'] + '-admin'):
        result = agent.tasks.run(agent_id=traefik, action='delete-route', data={'instance':instance})
        agent.assert_exp(result['exit_code'] == 0, 'Unable to remove route')
