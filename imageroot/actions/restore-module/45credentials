#!/usr/bin/env python3
"""Migrate/replay restored credentials without starting the restored service."""
from pathlib import Path
import sys
import agent
import vaultwarden_config as policy

if Path('vaultwarden.env').exists():
    try:
        with agent.exclusive_file_lock('configuration'):
            policy.ensure_worker_credential()
            policy.check_worker_credential()
    except Exception:
        # 10stop disables app and timer. Core may continue after this error;
        # service/worker read-only gates still refuse any incoherent pair.
        print('Restored worker credentials need recovery; service remains disabled', file=sys.stderr)
        sys.exit(1)
