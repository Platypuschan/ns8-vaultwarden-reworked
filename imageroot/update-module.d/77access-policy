#!/usr/bin/env python3
"""Pin the existing policy before starting the stateless revocation worker."""
import json
from pathlib import Path
import agent
import vaultwarden_config as policy
import vaultwarden_sso as sso
if Path('vaultwarden.env').exists():
    with agent.exclusive_file_lock('configuration'):
        config = policy.validate(json.loads(Path('settings.json').read_text()))
        sso.prepare(config)
        policy.require_policy(config, sso.task(config, 'get-client-access', {'domain': config['domain']}))
        policy.rotate_worker_token()
