#!/usr/bin/env python3
# Installations of 0.1.0-rc.1 have no admin token, admin route and
# revocation timer: add them. 80restart applies the new environment.
import json
import os
import subprocess
import sys

import agent
import vaultwarden_config as policy
import vaultwarden_sso

if not os.path.exists('vaultwarden.env'):
    sys.exit(0)
with agent.exclusive_file_lock('configuration'):
    with open('vaultwarden.env') as f:
        env = f.read()
    if not any(line.startswith('ADMIN_TOKEN=') for line in env.splitlines()):
        env = env.rstrip('\n') + '\nADMIN_TOKEN=' + policy.admin_token() + '\n'
    if not any(line.startswith('NS8_MANAGED_CONFIG=') for line in env.splitlines()):
        env = env.rstrip('\n') + '\nNS8_MANAGED_CONFIG=true\n'
    if not any(line.startswith('ADMIN_RATELIMIT_MAX_BURST=') for line in env.splitlines()):
        env = env.rstrip('\n') + '\nADMIN_RATELIMIT_MAX_BURST=30\n'
    policy.private_write('vaultwarden.env', env)
    if subprocess.run(['systemctl', '--user', '-q', 'is-enabled', 'vaultwarden.service']).returncode == 0:
        with open('settings.json') as f:
            config = json.load(f)
        traefik = agent.resolve_agent_id('traefik@node')
        agent.assert_exp(traefik is not None, 'Traefik not found')
        vaultwarden_sso.configure_admin_route(traefik, config)
        subprocess.run(['systemctl', '--user', 'enable', '--now', 'vaultwarden-revoke.timer'], check=True, stdout=sys.stderr)
