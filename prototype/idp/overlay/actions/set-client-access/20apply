#!/usr/bin/env python3
import json
import sys
import idprealm
import kcadmin
import idpaccess

request = json.load(sys.stdin)
idprealm.require_keycloak()
with idprealm.realms_lock():
    kc = kcadmin.agent_client()
    if request['domain'] not in kcadmin.managed_realms(kc):
        raise ValueError('Unmanaged realm')
    client = kc.find_client(request['domain'], request['client_id'])
    if not client or not client.get('attributes', {}).get('ns8.module_id'):
        raise ValueError('Client is not owned by an NS8 module')
    json.dump(idpaccess.apply(kc, request['domain'], request['client_id'], request['group_path']), sys.stdout)
