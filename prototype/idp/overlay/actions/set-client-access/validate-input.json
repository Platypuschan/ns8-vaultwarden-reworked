{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9.-]+$"
    },
    "client_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "group_path": {
      "type": "string",
      "minLength": 2,
      "pattern": "^/[^\\r\\n]+$"
    }
  },
  "required": [
    "domain",
    "client_id",
    "group_path"
  ],
  "additionalProperties": false
}
