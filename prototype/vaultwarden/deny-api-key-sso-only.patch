+// Shown instead of managed password values. The admin page warns about a
+// plain text ADMIN_TOKEN unless the field starts with "$argon2"; NS8 only
+// accepts a hashed token, so the mask of that field keeps the prefix.
+fn ns8_mask(name: &str) -> &'static str {
+    if name == "admin_token" { "$argon2id$********" } else { "********" }
+}
+
+// The NS8 module owns these values; the rest of the admin settings stay editable.
+fn ns8_managed(name: &str) -> bool {
+    get_env_bool("NS8_MANAGED_CONFIG").unwrap_or(false)
+        && (name.starts_with("sso_") || matches!(name,
+            "domain" | "admin_token" | "signups_allowed" | "invitations_allowed"
+            | "email_change_allowed" | "push_enabled" | "ip_header" | "ip_header_trusted_proxies"
+            | "allowed_iframe_ancestors")
+            // Further values the module sets itself (for example the SMTP
+            // connection when it follows the cluster smarthost)
+            || get_env::<String>("NS8_MANAGED_FIELDS").is_some_and(|list| list.split(',').any(|field| field == name)))
+}
+
